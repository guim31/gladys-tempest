{
  "manifest_version": 1,
  "type": "device",
  "name": "Tempest",
  "description": {
    "en": "WeatherFlow Tempest weather stations: live observations, lightning, rain and forecasts.",
    "fr": "Stations météo WeatherFlow Tempest : mesures en direct, éclairs, pluie et prévisions.",
    "de": "WeatherFlow-Tempest-Wetterstationen: Live-Messwerte, Blitze, Regen und Vorhersagen.",
    "es": "Estaciones meteorológicas WeatherFlow Tempest: datos en directo, rayos, lluvia y previsiones."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-tempest:1.0.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-tempest/main/cover.png",
  "categories": ["environment"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connect your Tempest account",
        "fr": "Connecter votre compte Tempest",
        "de": "Tempest-Konto verbinden",
        "es": "Conectar su cuenta Tempest"
      },
      "description": {
        "en": "Sign in to the Tempest web app (tempestwx.com), open Settings, then Data Authorizations, and create a personal access token. Paste it below: the stations of the account then appear in the Discovery tab.",
        "fr": "Connectez-vous à l'application web Tempest (tempestwx.com), ouvrez Paramètres, puis Autorisations de données, et créez un jeton d'accès personnel. Collez-le ci-dessous : les stations du compte apparaissent alors dans l'onglet Découverte.",
        "de": "Melde dich in der Tempest-Web-App (tempestwx.com) an, öffne die Einstellungen, dann „Data Authorizations“, und erstelle einen persönlichen Zugriffstoken. Füge ihn unten ein: Die Stationen des Kontos erscheinen dann im Tab „Erkennung“.",
        "es": "Inicie sesión en la aplicación web de Tempest (tempestwx.com), abra Ajustes, luego Autorizaciones de datos, y cree un token de acceso personal. Péguelo a continuación: las estaciones de la cuenta aparecerán en la pestaña Descubrimiento."
      },
      "links": [
        {
          "url": "https://tempestwx.com/settings/tokens",
          "label": {
            "en": "Create a token",
            "fr": "Créer un jeton",
            "de": "Token erstellen",
            "es": "Crear un token"
          }
        }
      ]
    },
    {
      "key": "token",
      "type": "secret",
      "required": true,
      "label": {
        "en": "Personal access token",
        "fr": "Jeton d'accès personnel",
        "de": "Persönlicher Zugriffstoken",
        "es": "Token de acceso personal"
      },
      "placeholder": {
        "en": "e.g. 12345678-abcd-…",
        "fr": "ex. 12345678-abcd-…",
        "de": "z. B. 12345678-abcd-…",
        "es": "p. ej. 12345678-abcd-…"
      }
    },
    {
      "key": "language",
      "type": "select",
      "default": "fr",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Feature names of the stations added from now on, precipitation type, forecast texts and scene sentences.",
        "fr": "Noms des fonctionnalités des stations ajoutées désormais, type de précipitation, textes des prévisions et phrases des scènes.",
        "de": "Namen der Funktionen künftig hinzugefügter Stationen, Niederschlagsart, Vorhersagetexte und Szenen-Sätze.",
        "es": "Nombres de las funciones de las estaciones añadidas a partir de ahora, tipo de precipitación, textos de previsión y frases de escenas."
      },
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    },
    {
      "key": "rapid_wind",
      "type": "boolean",
      "default": true,
      "label": {
        "en": "Instant wind every 3 seconds",
        "fr": "Vent instantané toutes les 3 secondes",
        "de": "Momentanwind alle 3 Sekunden",
        "es": "Viento instantáneo cada 3 segundos"
      },
      "description": {
        "en": "Updates the instant wind feature from the live feed every 3 seconds (not kept in the history). Off: it follows the one-minute average.",
        "fr": "Met à jour le vent instantané depuis le flux en direct toutes les 3 secondes (sans historique). Désactivé : il suit la moyenne à la minute.",
        "de": "Aktualisiert den Momentanwind alle 3 Sekunden aus den Live-Daten (ohne Verlauf). Aus: Er folgt dem Minutenmittel.",
        "es": "Actualiza el viento instantáneo desde los datos en directo cada 3 segundos (sin historial). Desactivado: sigue la media por minuto."
      }
    }
  ],
  "actions": [
    {
      "key": "list_stations",
      "timeout_seconds": 30,
      "label": {
        "en": "List my stations",
        "fr": "Lister mes stations",
        "de": "Meine Stationen auflisten",
        "es": "Listar mis estaciones"
      },
      "description": {
        "en": "Checks the token and lists the stations of the Tempest account.",
        "fr": "Vérifie le jeton et liste les stations du compte Tempest.",
        "de": "Prüft den Token und listet die Stationen des Tempest-Kontos auf.",
        "es": "Comprueba el token y lista las estaciones de la cuenta Tempest."
      }
    }
  ],
  "scene_triggers": [
    {
      "key": "rain_started",
      "label": {
        "en": "Tempest: it starts raining",
        "fr": "Tempest : il commence à pleuvoir",
        "de": "Tempest: Es beginnt zu regnen",
        "es": "Tempest: empieza a llover"
      },
      "description": {
        "en": "The station detects rain after at least 30 minutes without any. Fires once per rain episode.",
        "fr": "La station détecte de la pluie après au moins 30 minutes sans. Se déclenche une fois par épisode de pluie.",
        "de": "Die Station erkennt Regen nach mindestens 30 Minuten ohne. Löst einmal pro Regenepisode aus.",
        "es": "La estación detecta lluvia tras al menos 30 minutos sin ella. Se activa una vez por episodio de lluvia."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Station",
            "fr": "Station",
            "de": "Station",
            "es": "Estación"
          }
        }
      ],
      "variables": [
        {
          "key": "station",
          "type": "string",
          "label": {
            "en": "Station name",
            "fr": "Nom de la station",
            "de": "Name der Station",
            "es": "Nombre de la estación"
          }
        }
      ]
    },
    {
      "key": "lightning_nearby",
      "label": {
        "en": "Tempest: lightning nearby",
        "fr": "Tempest : éclair à proximité",
        "de": "Tempest: Blitz in der Nähe",
        "es": "Tempest: rayo cercano"
      },
      "description": {
        "en": "A lightning strike within the chosen distance, the first one for 30 minutes.",
        "fr": "Un éclair à moins de la distance choisie, le premier depuis 30 minutes.",
        "de": "Ein Blitz innerhalb der gewählten Entfernung, der erste seit 30 Minuten.",
        "es": "Un rayo dentro de la distancia elegida, el primero en 30 minutos."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Station",
            "fr": "Station",
            "de": "Station",
            "es": "Estación"
          }
        },
        {
          "key": "within_km",
          "type": "select",
          "required": true,
          "default": "10",
          "label": {
            "en": "Within",
            "fr": "À moins de",
            "de": "Innerhalb von",
            "es": "A menos de"
          },
          "options": [
            {
              "value": "5",
              "label": {
                "en": "5 km",
                "fr": "5 km",
                "de": "5 km",
                "es": "5 km"
              }
            },
            {
              "value": "10",
              "label": {
                "en": "10 km",
                "fr": "10 km",
                "de": "10 km",
                "es": "10 km"
              }
            },
            {
              "value": "15",
              "label": {
                "en": "15 km",
                "fr": "15 km",
                "de": "15 km",
                "es": "15 km"
              }
            },
            {
              "value": "20",
              "label": {
                "en": "20 km",
                "fr": "20 km",
                "de": "20 km",
                "es": "20 km"
              }
            },
            {
              "value": "30",
              "label": {
                "en": "30 km",
                "fr": "30 km",
                "de": "30 km",
                "es": "30 km"
              }
            },
            {
              "value": "40",
              "label": {
                "en": "40 km",
                "fr": "40 km",
                "de": "40 km",
                "es": "40 km"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "distance_km",
          "type": "number",
          "label": {
            "en": "Strike distance (km)",
            "fr": "Distance de l'éclair (km)",
            "de": "Entfernung des Blitzes (km)",
            "es": "Distancia del rayo (km)"
          }
        },
        {
          "key": "station",
          "type": "string",
          "label": {
            "en": "Station name",
            "fr": "Nom de la station",
            "de": "Name der Station",
            "es": "Nombre de la estación"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "forecast_summary",
      "timeout_seconds": 20,
      "label": {
        "en": "Tempest: forecast summary",
        "fr": "Tempest : résumé des prévisions",
        "de": "Tempest: Vorhersage-Zusammenfassung",
        "es": "Tempest: resumen de la previsión"
      },
      "description": {
        "en": "Today's or tomorrow's forecast of a station, as a sentence ready for a message, with its numbers.",
        "fr": "La prévision du jour ou du lendemain d'une station, en une phrase prête pour un message, avec ses valeurs.",
        "de": "Die Vorhersage einer Station für heute oder morgen, als Satz für eine Nachricht, mit ihren Werten.",
        "es": "La previsión de hoy o de mañana de una estación, en una frase lista para un mensaje, con sus valores."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Station",
            "fr": "Station",
            "de": "Station",
            "es": "Estación"
          },
          "required": true
        },
        {
          "key": "day",
          "type": "select",
          "default": "today",
          "label": {
            "en": "Day",
            "fr": "Jour",
            "de": "Tag",
            "es": "Día"
          },
          "options": [
            {
              "value": "today",
              "label": {
                "en": "Today",
                "fr": "Aujourd'hui",
                "de": "Heute",
                "es": "Hoy"
              }
            },
            {
              "value": "tomorrow",
              "label": {
                "en": "Tomorrow",
                "fr": "Demain",
                "de": "Morgen",
                "es": "Mañana"
              }
            }
          ]
        }
      ],
      "outputs": [
        {
          "key": "summary",
          "type": "string",
          "label": {
            "en": "Forecast sentence",
            "fr": "Phrase de prévision",
            "de": "Vorhersage-Satz",
            "es": "Frase de previsión"
          }
        },
        {
          "key": "condition",
          "type": "string",
          "label": {
            "en": "Conditions",
            "fr": "Conditions",
            "de": "Wetterlage",
            "es": "Condiciones"
          }
        },
        {
          "key": "temperature_min",
          "type": "number",
          "label": {
            "en": "Minimum (°C)",
            "fr": "Minimum (°C)",
            "de": "Tiefstwert (°C)",
            "es": "Mínima (°C)"
          }
        },
        {
          "key": "temperature_max",
          "type": "number",
          "label": {
            "en": "Maximum (°C)",
            "fr": "Maximum (°C)",
            "de": "Höchstwert (°C)",
            "es": "Máxima (°C)"
          }
        },
        {
          "key": "precipitation_probability",
          "type": "number",
          "label": {
            "en": "Chance of rain (%)",
            "fr": "Risque de pluie (%)",
            "de": "Regenwahrscheinlichkeit (%)",
            "es": "Probabilidad de lluvia (%)"
          }
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "station",
      "icon": "cloud-drizzle",
      "label": {
        "en": "Tempest station",
        "fr": "Station Tempest",
        "de": "Tempest-Station",
        "es": "Estación Tempest"
      },
      "description": {
        "en": "Live observation and forecast of a Tempest station.",
        "fr": "Observation en direct et prévisions d'une station Tempest.",
        "de": "Live-Beobachtung und Vorhersage einer Tempest-Station.",
        "es": "Observación en directo y previsión de una estación Tempest."
      },
      "settings": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Station",
            "fr": "Station",
            "de": "Station",
            "es": "Estación"
          },
          "required": true
        },
        {
          "key": "forecast",
          "type": "select",
          "default": "daily",
          "label": {
            "en": "Forecast",
            "fr": "Prévisions",
            "de": "Vorhersage",
            "es": "Previsión"
          },
          "options": [
            {
              "value": "daily",
              "label": {
                "en": "Next days",
                "fr": "Prochains jours",
                "de": "Nächste Tage",
                "es": "Próximos días"
              }
            },
            {
              "value": "hourly",
              "label": {
                "en": "Next hours",
                "fr": "Prochaines heures",
                "de": "Nächste Stunden",
                "es": "Próximas horas"
              }
            }
          ]
        }
      ]
    }
  ]
}
